# Express API base URL (same as web VITE_BACKEND_URL). NOT the Neon string; NOT your static site URL.
# Local: http://localhost:3001 | Android emulator: http://10.0.2.2:3001
#
# On Render you usually have TWO URLs: (1) Static Site = Vite app in browser
# (2) Web Service (Node) = API. This MUST be (2). Check: GET https://YOUR-API/health returns JSON.
#
# Your marketing site may be https://digital-will-coc4.onrender.com — that is (1), not the API.
# Set (2) from Render Dashboard → Web Service → URL, e.g.:
# EXPO_PUBLIC_BACKEND_URL=https://digital-will-api-xxxx.onrender.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional: only for login_activity sync if you still use Supabase for that table
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Same as web (VITE_ADMIN_EMAIL): primary admin email for super-admin UI flags
EXPO_PUBLIC_ADMIN_EMAIL=admin@legacywallet.com

# Optional: Expo account slug if not using iuindia (default in app.config.js)
# EXPO_ACCOUNT_OWNER=iuindia

# Optional: only for CI/non-interactive builds after the project is linked
# EAS_PROJECT_ID=
